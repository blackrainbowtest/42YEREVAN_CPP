===== build =====
rm -f obj/main.o obj/ScalarConverter.o
rm -rf obj/
rm -f convert
mkdir -p obj/
c++ -Wall -Wextra -Werror -std=c++98 -I include/ -o obj/main.o -c src/main.cpp
mkdir -p obj/
c++ -Wall -Wextra -Werror -std=c++98 -I include/ -o obj/ScalarConverter.o -c src/ScalarConverter.cpp
c++ -Wall -Wextra -Werror -std=c++98 obj/main.o obj/ScalarConverter.o -o convert

